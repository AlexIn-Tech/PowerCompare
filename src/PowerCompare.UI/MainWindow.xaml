<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PowerCompare" Width="1280" Height="820" MinWidth="900" MinHeight="560"
        Background="#F4F6FA" FontFamily="Segoe UI" FontSize="13" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="14,7"/><Setter Property="Margin" Value="4,0"/>
      <Setter Property="Background" Value="#E7ECF4"/><Setter Property="BorderBrush" Value="#CDD5E1"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="8,6"/><Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="BorderBrush" Value="#CDD5E1"/>
    </Style>
    <Style TargetType="DataGridRow">
      <Setter Property="MinHeight" Value="30"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Status}" Value="Different"><Setter Property="Foreground" Value="#AD4D00"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="LeftOnly"><Setter Property="Foreground" Value="#2165B5"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="RightOnly"><Setter Property="Foreground" Value="#008466"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="Error"><Setter Property="Foreground" Value="#BF2340"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="TypeConflict"><Setter Property="Foreground" Value="#BF2340"/></DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>
  <DockPanel Margin="22">
    <Border DockPanel.Dock="Top" Padding="0,0,0,18">
      <Grid>
        <StackPanel><TextBlock Text="PowerCompare" FontSize="28" FontWeight="SemiBold" Foreground="#18335A"/>
          <TextBlock Text="Compare with confidence" Foreground="#66748B" Margin="0,3,0,0"/></StackPanel>
        <TextBlock Text="PowerShell · WPF" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#66748B"/>
      </Grid>
    </Border>
    <Border DockPanel.Dock="Bottom" Background="#E8EDF5" Padding="12,9" Margin="0,12,0,0" CornerRadius="4">
      <DockPanel>
        <ProgressBar x:Name="WorkProgress" Width="110" Height="6" DockPanel.Dock="Right" Visibility="Collapsed" IsIndeterminate="True"/>
        <TextBlock x:Name="StatusText" Text="Choose two folders to compare." Foreground="#405575" TextWrapping="Wrap"/>
      </DockPanel>
    </Border>
    <TabControl x:Name="WorkspaceTabs" Background="White" BorderBrush="#CDD5E1" Padding="16">
      <TabItem Header="Folder comparison">
        <DockPanel>
          <Grid DockPanel.Dock="Top" Margin="0,8,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0"><TextBlock Text="LEFT FOLDER" FontWeight="SemiBold" Foreground="#66748B" Margin="0,0,0,6"/>
              <DockPanel><Button x:Name="BrowseLeft" Content="Browse…" DockPanel.Dock="Right"/><TextBox x:Name="LeftRoot" ToolTip="Left folder path"/></DockPanel>
            </StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="RIGHT FOLDER" FontWeight="SemiBold" Foreground="#66748B" Margin="0,0,0,6"/>
              <DockPanel><Button x:Name="BrowseRight" Content="Browse…" DockPanel.Dock="Right"/><TextBox x:Name="RightRoot" ToolTip="Right folder path"/></DockPanel>
            </StackPanel>
          </Grid>
          <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,14" VerticalAlignment="Center">
            <Button x:Name="CompareButton" Content="Compare" Background="#245DB5" Foreground="White" FontWeight="SemiBold"/>
            <Button x:Name="CancelButton" Content="Cancel" IsEnabled="False"/>
            <ComboBox x:Name="ModeSelector" SelectedIndex="0" Width="130" Margin="12,0,8,0" VerticalContentAlignment="Center">
              <ComboBoxItem Content="Content"/><ComboBoxItem Content="Metadata"/>
            </ComboBox>
            <CheckBox x:Name="DifferencesOnly" Content="Differences only" VerticalAlignment="Center" Margin="4,0,10,0"/>
            <TextBox x:Name="IncludeFilter" Text="*" Width="110" ToolTip="Include masks separated by semicolons" Margin="3,0"/>
            <TextBox x:Name="ExcludeFilter" Width="110" ToolTip="Exclude masks separated by semicolons" Margin="3,0"/>
          </WrapPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <Button x:Name="SaveSession" Content="Save session…"/>
            <Button x:Name="LoadSession" Content="Load session…"/>
            <Button x:Name="ExportReport" Content="Export report…"/>
            <Button x:Name="OpenText" Content="Open text comparison"/>
            <Button x:Name="CopyLeftToRight" Content="Copy selected →"/>
            <Button x:Name="CopyRightToLeft" Content="← Copy selected"/>
          </StackPanel>
          <DataGrid x:Name="ResultsGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended"
                    CanUserAddRows="False" CanUserDeleteRows="False" GridLinesVisibility="Horizontal"
                    HorizontalGridLinesBrush="#EDF0F5" HeadersVisibility="Column" BorderBrush="#CDD5E1"
                    EnableRowVirtualization="True" EnableColumnVirtualization="True">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Relative path" Binding="{Binding RelativePath}" Width="2*"/>
              <DataGridTextColumn Header="Type" Binding="{Binding EntryType}" Width="80"/>
              <DataGridTextColumn Header="Result" Binding="{Binding Status}" Width="130"/>
              <DataGridTextColumn Header="Left size" Binding="{Binding LeftLength}" Width="90"/>
              <DataGridTextColumn Header="Right size" Binding="{Binding RightLength}" Width="90"/>
              <DataGridTextColumn Header="Left modified" Binding="{Binding LeftLastWriteTimeUtc}" Width="140"/>
              <DataGridTextColumn Header="Right modified" Binding="{Binding RightLastWriteTimeUtc}" Width="140"/>
              <DataGridTextColumn Header="Details" Binding="{Binding Error}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>
      <TabItem x:Name="OperationsTab" Header="File operations">
        <DataGrid x:Name="OperationResults" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False">
          <DataGrid.Columns>
            <DataGridTextColumn Header="File" Binding="{Binding RelativePath}" Width="*"/>
            <DataGridTextColumn Header="Result" Binding="{Binding Status}" Width="100"/>
            <DataGridTextColumn Header="Destination" Binding="{Binding DestinationPath}" Width="*"/>
            <DataGridTextColumn Header="Backup" Binding="{Binding BackupPath}" Width="*"/>
            <DataGridTextColumn Header="Details" Binding="{Binding Error}" Width="*"/>
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
      <TabItem Header="About">
        <StackPanel Margin="18">
          <TextBlock Text="PowerCompare" FontSize="24" FontWeight="SemiBold"/>
          <TextBlock Text="PowerShell application logic. WPF desktop interface. Pester test coverage." Margin="0,10,0,0" TextWrapping="Wrap"/>
          <TextBlock Text="Content mode verifies file bytes. Metadata matches do not verify content." Margin="0,10,0,0" TextWrapping="Wrap"/>
          <TextBlock Text="Symbolic links and junctions are reported without traversal." Margin="0,10,0,0" TextWrapping="Wrap"/>
        </StackPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
