<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Text comparison — PowerCompare" Width="1200" Height="750" MinWidth="750" MinHeight="400" FontFamily="Segoe UI" WindowStartupLocation="CenterOwner">
  <DockPanel Margin="18">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <TextBlock x:Name="TextPaths" FontWeight="SemiBold" TextWrapping="Wrap"/>
      <StackPanel Orientation="Horizontal" Margin="0,12,0,8">
        <Button x:Name="PreviousDifference" Content="← Previous difference" Padding="12,6" Margin="0,0,8,0"/>
        <Button x:Name="NextDifference" Content="Next difference →" Padding="12,6"/>
        <Button x:Name="EditLeftText" Content="Edit left…" Padding="12,6" Margin="8,0,0,0"/>
        <Button x:Name="EditRightText" Content="Edit right…" Padding="12,6" Margin="8,0,0,0"/>
        <Button x:Name="MergeText" Content="Three-way merge…" Padding="12,6" Margin="8,0,0,0"/>
        <Button x:Name="CancelText" Content="Cancel" Padding="12,6" Margin="8,0,0,0"/>
      </StackPanel>
      <TextBlock x:Name="TextSummary" Text="Loading comparison…" Foreground="#52647F" TextWrapping="Wrap"/>
    </StackPanel>
    <DataGrid x:Name="TextRows" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
              FontFamily="Consolas" FontSize="13" EnableRowVirtualization="True" SelectionMode="Single" HeadersVisibility="Column">
      <DataGrid.Columns>
        <DataGridTextColumn Header="#" Binding="{Binding LeftLineNumber}" Width="48"/>
        <DataGridTextColumn Header="EOL" Binding="{Binding LeftLineEnding}" Width="55"/>
        <DataGridTemplateColumn Header="Left text" Width="*">
          <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Padding="4"><Run Text="{Binding LeftBefore}"/><Run Text="{Binding LeftChanged}" Background="#FFD9B0"/><Run Text="{Binding LeftAfter}"/></TextBlock></DataTemplate></DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Result" Binding="{Binding Status}" Width="90"/>
        <DataGridTextColumn Header="#" Binding="{Binding RightLineNumber}" Width="48"/>
        <DataGridTextColumn Header="EOL" Binding="{Binding RightLineEnding}" Width="55"/>
        <DataGridTemplateColumn Header="Right text" Width="*">
          <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Padding="4"><Run Text="{Binding RightBefore}"/><Run Text="{Binding RightChanged}" Background="#C8F0DE"/><Run Text="{Binding RightAfter}"/></TextBlock></DataTemplate></DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
